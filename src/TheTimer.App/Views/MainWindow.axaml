<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TheTimer.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="620"
        x:Class="TheTimer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="420" Height="620"
        Icon="/Assets/thetimer.png"
        Title="TheTimer">

    <TabControl>
        <TabItem Header="Zamanlayıcı">
    <DockPanel>
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasPendingRecovery}" Margin="16,16,16,0" Padding="12"
            CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding RecoveryText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Devam et" Command="{Binding ResumePendingCommand}" IsVisible="{Binding CanResumePending}" />
                <Button Content="Kaydet" Command="{Binding SavePendingCommand}" />
                <Button Content="Sil" Command="{Binding DiscardPendingCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="16" RowSpacing="12">
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"
                    IsEnabled="{Binding IsEditable}">
            <RadioButton GroupName="Mode" Content="Kronometre" IsChecked="{Binding IsStopwatchMode}" />
            <RadioButton GroupName="Mode" Content="Geri sayım" IsChecked="{Binding IsCountdownMode}" />
            <RadioButton GroupName="Mode" Content="Pomodoro" IsChecked="{Binding IsPomodoroMode}" />
        </StackPanel>
        <TextBox Grid.Row="1" PlaceholderText="Görev adı"
                 Text="{Binding TaskName}" IsReadOnly="{Binding !IsEditable}" />
        <TextBox Grid.Row="2" PlaceholderText="Etiket (isteğe bağlı)"
                 Text="{Binding Tag}" IsReadOnly="{Binding !IsEditable}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"
                    IsVisible="{Binding IsCountdownMode}">
            <TextBlock Text="Süre (dk)" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding CountdownMinutes}" Minimum="1" Maximum="600" Increment="1"
                           FormatString="0" IsEnabled="{Binding IsEditable}" Width="140" />
        </StackPanel>
        <TextBlock Grid.Row="3" Text="{Binding PhaseText}" IsVisible="{Binding IsPomodoroMode}"
                   HorizontalAlignment="Center" FontSize="18" />

        <TextBlock Grid.Row="4" Text="{Binding ElapsedText}"
                   FontFamily="monospace" FontSize="56" HorizontalAlignment="Center" />
        <TextBlock Grid.Row="5" Text="{Binding StateText}" HorizontalAlignment="Center" Opacity="0.7" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button Content="Başlat" Command="{Binding StartCommand}" />
            <Button Content="Duraklat" Command="{Binding PauseCommand}" IsVisible="{Binding !IsPaused}" />
            <Button Content="Devam" Command="{Binding ResumeCommand}" IsVisible="{Binding IsPaused}" />
            <Button Content="Durdur" Command="{Binding StopCommand}" />
            <Button Content="Sıfırla" Command="{Binding ResetPomodoroCommand}" IsVisible="{Binding IsPomodoroMode}" />
        </StackPanel>

    </Grid>
    </DockPanel>
            </TabItem>
            <TabItem Header="Bugün">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="16" RowSpacing="8">
                    <TextBlock Grid.Row="0" Text="{Binding DateText}" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock Grid.Row="1" Text="{Binding TotalText}" FontFamily="monospace" FontSize="16" />
                    <TextBlock Grid.Row="2" Text="Bugün henüz kayıtlı oturum yok." Opacity="0.6"
                               IsVisible="{Binding !HasSessions}" />
                    <StackPanel Grid.Row="3" Spacing="4" IsVisible="{Binding HasSessions}">
                        <TextBlock Text="Görevlere göre" FontWeight="SemiBold" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding TaskTotals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskTotalItemViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding TaskName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Opacity="0.6" />
                                        <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontFamily="monospace" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding HasSessions}">
                        <TextBlock Grid.Row="0" Text="Oturumlar" FontWeight="SemiBold" FontSize="16" />
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding TodaySessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionItemViewModel">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" Margin="0,4">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TaskName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DurationText}" FontFamily="monospace" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Tag}" IsVisible="{Binding HasTag}" Opacity="0.6" FontSize="12" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TimeRange}" Opacity="0.6" FontSize="12" />
                                            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="✕"
                                                    ToolTip.Tip="Sil" Padding="6,2" VerticalAlignment="Center"
                                                    Command="{Binding DeleteCommand}" CommandParameter="{Binding Id}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
</Window>
