<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TheTimer.App.ViewModels"
        xmlns:views="using:TheTimer.App.Views"
        xmlns:c="using:TheTimer.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="TheTimer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="780" MinWidth="960" MinHeight="640"
        Icon="/Assets/thetimer.png"
        Title="TheTimer">

    <Panel>
    <c:StarField />
    <TabControl Classes="rail" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem>
            <TabItem.Header>
                <StackPanel Spacing="6">
                    <c:Icon Data="{StaticResource Icon.Timer}" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Classes="nav-label" Text="ZAMANLAYICI" />
                </StackPanel>
            </TabItem.Header>
                <views:TimerView />
            </TabItem>
            <TabItem>
            <TabItem.Header>
                <StackPanel Spacing="6">
                    <c:Icon Data="{StaticResource Icon.Plan}" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Classes="nav-label" Text="PLAN" />
                </StackPanel>
            </TabItem.Header>
                <views:PlanView DataContext="{Binding Plan}" />
            </TabItem>
            <TabItem>
            <TabItem.Header>
                <StackPanel Spacing="6">
                    <c:Icon Data="{StaticResource Icon.Today}" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Classes="nav-label" Text="BUGÜN" />
                </StackPanel>
            </TabItem.Header>
                <views:TodayView />
            </TabItem>
            <TabItem>
            <TabItem.Header>
                <StackPanel Spacing="6">
                    <c:Icon Data="{StaticResource Icon.Report}" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Classes="nav-label" Text="RAPOR" />
                </StackPanel>
            </TabItem.Header>
                <views:ReportView DataContext="{Binding Report}" />
            </TabItem>
    </TabControl>
    </Panel>
</Window>
