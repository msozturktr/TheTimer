<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 24x24 outline glyphs, stroke-drawn by Controls/Icon (original paths in the Material Symbols outlined style;
         the Apache-2.0 Material icon set was the visual reference, no path data is copied). -->
