<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TheTimer.App.ViewModels"
             xmlns:c="using:TheTimer.App.Controls"
             xmlns:ct="using:TheTimer.App.Controls.Timer"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1112" d:DesignHeight="780"
             x:Class="TheTimer.App.Views.TimerView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <StreamGeometry x:Key="Icon.Reset">M4.5 12a7.5 7.5 0 1 0 2.4-5.5 M4.5 4.5v4h4</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Minimal underline field used for the task/tag inputs in the dial. -->
        <Style Selector="TextBox.line">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,4,4,5" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Amber}" />
        </Style>
        <Style Selector="TextBox.line /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox.line:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
        </Style>
        <Style Selector="TextBox.line:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Amber}" />
        </Style>
        <Style Selector="TextBox.line:focus">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.task">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style Selector="TextBox.tag">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="NumericUpDown.minutes">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Width" Value="116" />
        </Style>
        <Style Selector="Button.round.primary#PrimaryButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="Button.round.primary#PrimaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Rose}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Rose}" />
            <Setter Property="Background" Value="#14FF6B81" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,Auto">
        <!-- ================= Main column ================= -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

            <!-- Recovery banner -->
            <Border Grid.Row="0" Classes="panel" IsVisible="{Binding HasPendingRecovery}" Padding="0"
                    MaxWidth="680" HorizontalAlignment="Center" Margin="24,20,24,0" ClipToBounds="True"
                    CornerRadius="14" Background="#F00B0F26">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.ColumnSpan="3" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#2EFFB547" Offset="0" />
                                <GradientStop Color="#00FFB547" Offset="0.45" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Grid.Column="0" Width="3" Background="{DynamicResource Brush.Amber}" />
                    <TextBlock Grid.Column="1" Text="{Binding RecoveryText}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Margin="18,14,12,14" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Button Classes="primary" Content="Devam et" Padding="14,6" FontSize="12"
                                Command="{Binding ResumePendingCommand}" IsVisible="{Binding CanResumePending}" />
                        <Button Classes="ghost" Content="Kaydet" Command="{Binding SavePendingCommand}" />
                        <Button Classes="ghost danger" Content="Sil" Command="{Binding DiscardPendingCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Top bar: clock chip + mode switch -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="24,20,24,0">
                <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="999"
                        BorderThickness="1" BorderBrush="{DynamicResource Brush.Hairline}" Padding="12,5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Brush.Mint}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ClockText}" Classes="mono faint" FontSize="11" LetterSpacing="0.8" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="segments" IsEnabled="{Binding IsEditable}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton Classes="segment" GroupName="Mode" Content="Kronometre" IsChecked="{Binding IsStopwatchMode}" />
                        <RadioButton Classes="segment" GroupName="Mode" Content="Geri sayım" IsChecked="{Binding IsCountdownMode}" />
                        <RadioButton Classes="segment" GroupName="Mode" Content="Pomodoro" IsChecked="{Binding IsPomodoroMode}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Dial + controls -->
            <Grid Grid.Row="2" RowDefinitions="*,Auto" VerticalAlignment="Center" Margin="24,12,24,16">
                <Viewbox Grid.Row="0" MaxHeight="480" MaxWidth="480" Stretch="Uniform">
                    <Grid Width="460" Height="460">
                        <ct:AstrolabeDial Width="460" Height="460"
                                          Progress="{Binding DialProgress}" Kind="{Binding DialKind}"
                                          IsActive="{Binding DialActive}" IsRunning="{Binding IsTimerRunning}"
                                          TargetMinutes="{Binding DialTargetMinutes}" MoonCount="{Binding MoonCount}"
                                          MoonsCompleted="{Binding MoonsCompleted}" MoonCurrent="{Binding MoonCurrent}" />

                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="270" Margin="0,104,0,0" Spacing="5">
                            <TextBlock Text="{Binding OverlineText}" Classes="overline amber" HorizontalAlignment="Center"
                                       FontSize="11" LetterSpacing="2.4" />
                            <Viewbox Height="104" MaxWidth="280" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BigTimeText}" Classes="numeral-xl" FontSize="84"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Viewbox>

                            <!-- Idle: editable fields -->
                            <StackPanel IsVisible="{Binding IsEditable}" Spacing="9" HorizontalAlignment="Center">
                                <TextBox Classes="line task" Width="250" PlaceholderText="Görev adı" Text="{Binding TaskName}" />
                                <TextBox Classes="line tag" Width="140" PlaceholderText="Etiket" Text="{Binding Tag}" />
                                <StackPanel IsVisible="{Binding IsCountdownMode}" Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Center" Margin="0,2,0,0">
                                    <NumericUpDown Classes="minutes" Value="{Binding CountdownMinutes}" Minimum="1" Maximum="600"
                                                   Increment="1" FormatString="0" />
                                    <TextBlock Text="dk" Classes="mono faint" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Active: read-only presentation -->
                            <StackPanel IsVisible="{Binding !IsEditable}" Spacing="9" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DisplayTaskName}" Classes="serif-italic" FontSize="21"
                                           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="270"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" />
                                <Border IsVisible="{Binding HasTagPill}" CornerRadius="999" Padding="12,4" HorizontalAlignment="Center"
                                        BorderThickness="1" BorderBrush="#4D7DD3FC" Background="#0F7DD3FC">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Brush.Cyan}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TagPillText}" Classes="mono cyan" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Border IsVisible="{Binding ShowHoursChip}" VerticalAlignment="Top" HorizontalAlignment="Center"
                                Margin="0,336,0,0" CornerRadius="999" Padding="10,3" BorderThickness="1"
                                BorderBrush="{DynamicResource Brush.AmberRing}" Background="#14FFB547">
                            <TextBlock Text="{Binding HoursChipText}" Classes="mono amber" FontSize="10" LetterSpacing="1" />
                        </Border>
                    </Grid>
                </Viewbox>

                <StackPanel Grid.Row="1" Margin="0,30,0,0" Spacing="12" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="26" HorizontalAlignment="Center">
                        <Panel Width="48" Height="48" VerticalAlignment="Center">
                            <Button Classes="round" Width="48" Height="48" Command="{Binding StopCommand}" ToolTip.Tip="Durdur">
                                <c:Icon Data="{StaticResource Icon.Stop}" Width="20" Height="20" />
                            </Button>
                        </Panel>
                        <Panel Width="76" Height="76">
                        <Ellipse Width="170" Height="170" IsHitTestVisible="False" IsVisible="{Binding #PrimaryButton.IsEffectivelyEnabled}">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#50FF9650" Offset="0.38" />
                                    <GradientStop Color="#20FF9650" Offset="0.62" />
                                    <GradientStop Color="#00FF9650" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Button x:Name="PrimaryButton" Classes="round primary" Width="76" Height="76" Command="{Binding PrimaryCommand}"
                                ToolTip.Tip="{Binding PrimaryTip}">
                            <Panel>
                                <c:Icon Data="{StaticResource Icon.Play}" Width="32" Height="32" IsFilled="True"
                                        IsVisible="{Binding !IsTimerRunning}" />
                                <c:Icon Data="{StaticResource Icon.Pause}" Width="32" Height="32" IsFilled="True"
                                        IsVisible="{Binding IsTimerRunning}" />
                            </Panel>
                        </Button>
                        </Panel>
                        <Panel Width="48" Height="48" VerticalAlignment="Center">
                            <Button Classes="round" Width="48" Height="48" Command="{Binding ResetPomodoroCommand}"
                                    IsVisible="{Binding ShowReset}" ToolTip.Tip="Sıfırla">
                                <c:Icon Data="{StaticResource Icon.Reset}" Width="20" Height="20" />
                            </Button>
                        </Panel>
                    </StackPanel>
                    <TextBlock Text="{Binding CaptionText}" Classes="overline" HorizontalAlignment="Center"
                               FontSize="10.5" LetterSpacing="2" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= Today panel ================= -->
        <Border x:Name="SidePanel" Grid.Column="1" Classes="panel" Width="300" Margin="0,24,24,24" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,22,22,20" Spacing="22">
                    <StackPanel Spacing="8">
                        <TextBlock Text="BUGÜN" Classes="overline" />
                        <TextBlock Text="{Binding DateShortText}" Classes="h2" />
                        <Border Classes="hairline-top" Margin="0,8,0,0" Height="1" />
                    </StackPanel>

                    <Border Classes="card" Padding="16,14" CornerRadius="14" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#171C38" Offset="0" />
                                <GradientStop Color="#1F1D33" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Spacing="8">
                            <TextBlock Text="TOPLAM ODAK" Classes="overline" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding TotalFocusText}" Classes="numeral-lg" FontSize="40"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="{Binding TotalFocusUnit}" Classes="mono faint" VerticalAlignment="Bottom"
                                           Margin="0,0,0,9" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="10">
                        <TextBlock Text="GÜNÜN AKIŞI" Classes="overline" />
                        <ct:DayRibbon Segments="{Binding RibbonSegments}" NowMinute="{Binding RibbonNowMinute}" />
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="SON OTURUMLAR" Classes="overline" />
                        <TextBlock Text="Bugün henüz kayıtlı oturum yok." Classes="faint" FontSize="12.5"
                                   IsVisible="{Binding !HasRecentSessions}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding RecentSessions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentSessionItem">
                                    <Border Classes="card" Padding="12,9" CornerRadius="12" Background="#0FFFFFFF">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TaskName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TagText}" IsVisible="{Binding HasTag}" Classes="mono cyan"
                                                           FontSize="10.5" Opacity="0.8" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DurationText}" Classes="mono secondary"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
