    <StreamGeometry x:Key="Icon.Today">M6 4.5h12a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-11a2 2 0 0 1 2-2Z M4 9.5h16 M8 2.5v3 M16 2.5v3 M8.5 12.8h3v3h-3Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Report">M5 20V12 M12 20V5 M19 20v-9 M3.5 20.5h17</StreamGeometry>
