<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TheTimer.App.ViewModels"
        xmlns:views="using:TheTimer.App.Views"
        xmlns:c="using:TheTimer.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="TheTimer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200" Height="780" MinWidth="960" MinHeight="640"
        Icon="/Assets/thetimer.png"
        Title="TheTimer">

    <Panel>
    <c:StarField />
    <TabControl Classes="rail" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem>
            <TabItem.Header>
                <StackPanel Spacing="6">
                    <c:Icon Data="{StaticResource Icon.Timer}" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Classes="nav-label" Text="ZAMANLAYICI" />
                </StackPanel>
            </TabItem.Header>
                <views:TimerView />
            </TabItem>
            <TabItem>
            <TabItem.Header>
                <StackPanel Spacing="6">
                    <c:Icon Data="{StaticResource Icon.Plan}" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Classes="nav-label" Text="PLAN" />
                </StackPanel>
            </TabItem.Header>
                <views:PlanView DataContext="{Binding Plan}" />
            </TabItem>
            <TabItem>
            <TabItem.Header>
                <StackPanel Spacing="6">
                    <c:Icon Data="{StaticResource Icon.Today}" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Classes="nav-label" Text="BUGÜN" />
                </StackPanel>
            </TabItem.Header>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24,16" RowSpacing="8" MaxWidth="880">
                    <TextBlock Grid.Row="0" Text="{Binding DateText}" Classes="h2" />
                    <TextBlock Grid.Row="1" Text="{Binding TotalText}" FontFamily="monospace" FontSize="16" />
                    <TextBlock Grid.Row="2" Text="Bugün henüz kayıtlı oturum yok." Opacity="0.6"
                               IsVisible="{Binding !HasSessions}" />
                    <StackPanel Grid.Row="3" Spacing="4" IsVisible="{Binding HasSessions}">
                        <TextBlock Text="Görevlere göre" FontWeight="SemiBold" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding TaskTotals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TaskTotalItemViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding TaskName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Opacity="0.6" />
                                        <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontFamily="monospace" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding HasSessions}">
                        <TextBlock Grid.Row="0" Text="Oturumlar" FontWeight="SemiBold" FontSize="16" />
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding TodaySessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionItemViewModel">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" Margin="0,4">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TaskName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DurationText}" FontFamily="monospace" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Tag}" IsVisible="{Binding HasTag}" Opacity="0.6" FontSize="12" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TimeRange}" Opacity="0.6" FontSize="12" />
                                            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Classes="round" Width="30" Height="30"
                                                    ToolTip.Tip="Sil" VerticalAlignment="Center"
                                                    Command="{Binding DeleteCommand}" CommandParameter="{Binding Id}">
                                                <c:Icon Data="{StaticResource Icon.Delete}" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem>
            <TabItem.Header>
                <StackPanel Spacing="6">
                    <c:Icon Data="{StaticResource Icon.Report}" Width="22" Height="22" HorizontalAlignment="Center" />
                    <TextBlock Classes="nav-label" Text="RAPOR" />
                </StackPanel>
            </TabItem.Header>
                <views:ReportView DataContext="{Binding Report}" />
            </TabItem>
    </TabControl>
    </Panel>
</Window>
