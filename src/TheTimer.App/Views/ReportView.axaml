<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TheTimer.App.ViewModels"
             xmlns:c="using:TheTimer.App.Controls"
             xmlns:rc="using:TheTimer.App.Controls.Report"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="TheTimer.App.Views.ReportView"
             x:DataType="vm:ReportViewModel">
    <UserControl.Styles>
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        </Style>
        <Style Selector="Border.chip.pos">
            <Setter Property="Background" Value="#1A5EEAD4" />
            <Setter Property="BorderBrush" Value="#475EEAD4" />
        </Style>
        <Style Selector="Border.chip.neg">
            <Setter Property="Background" Value="#1AFF6B81" />
            <Setter Property="BorderBrush" Value="#47FF6B81" />
        </Style>
        <Style Selector="Border.chip.peak">
            <Setter Property="Background" Value="#1FFFB547" />
            <Setter Property="BorderBrush" Value="#59FFB547" />
            <Setter Property="Padding" Value="9,3" />
        </Style>
        <Style Selector="Border.chip.pos > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Mint}" />
        </Style>
        <Style Selector="Border.chip.neg > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Rose}" />
        </Style>
        <Style Selector="Border.chip.peak > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Amber}" />
        </Style>
        <Style Selector="TextBlock.tiny">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
        </Style>
        <Style Selector="TextBlock.tiny.mint">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Mint}" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,10" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,28" Spacing="16" MaxWidth="1140">

            <!-- Header -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border CornerRadius="999" Width="6" Height="6" Background="{DynamicResource Brush.Amber}" VerticalAlignment="Center" BoxShadow="{DynamicResource Shadow.AmberDot}" />
                    <TextBlock Text="HAFTALIK RAPOR" Classes="overline" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <TextBlock Text="{Binding WeekText}" Classes="h1" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="round" Width="32" Height="32" Command="{Binding PreviousWeekCommand}" ToolTip.Tip="Önceki hafta">
                            <c:Icon Data="{StaticResource Icon.ChevronLeft}" Width="16" Height="16" />
                        </Button>
                        <Button Classes="ghost" Content="{Binding WeekNavLabel}" ToolTip.Tip="Bu haftaya dön" Command="{Binding ThisWeekCommand}" IsEnabled="{Binding !IsCurrentWeek}" />
                        <Button Classes="round" Width="32" Height="32" Command="{Binding NextWeekCommand}" ToolTip.Tip="Sonraki hafta">
                            <c:Icon Data="{StaticResource Icon.ChevronRight}" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Stat cards -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="panel" Padding="22,16">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Amber}" VerticalAlignment="Center" />
                            <TextBlock Text="GERÇEKLEŞEN" Classes="overline" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding ActualTotalText}" Classes="numeral-lg amber" FontSize="44" />
                            <TextBlock Text="sa" Classes="mono faint" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                        </StackPanel>
                        <TextBlock Text="{Binding SessionsText}" Classes="secondary" FontSize="13" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="panel" Padding="22,16">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="6" Height="6" Stroke="{DynamicResource Brush.Cyan}" StrokeThickness="1.2" VerticalAlignment="Center" />
                            <TextBlock Text="PLANLANAN" Classes="overline" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding PlannedTotalText}" Classes="numeral-lg cyan" FontSize="44" />
                            <TextBlock Text="sa" Classes="mono faint" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                        </StackPanel>
                        <TextBlock Text="{Binding BlocksText}" Classes="secondary" FontSize="13" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="panel" Padding="22,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Coral}" VerticalAlignment="Center" />
                                <TextBlock Text="GERÇEKLEŞME ORANI" Classes="overline" />
                            </StackPanel>
                            <TextBlock Text="{Binding PercentText}" Classes="numeral-lg amber" FontSize="44" />
                            <TextBlock Text="{Binding PercentSubText}" Classes="secondary" FontSize="13" />
                        </StackPanel>
                        <rc:GaugeRing Grid.Column="1" Width="72" Height="72" Value="{Binding PercentValue}"
                                      IsVisible="{Binding HasPlan}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Hero chart -->
            <Border Classes="panel" Padding="26,22,26,14">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="HAFTALIK" Classes="overline" />
                            <TextBlock Text="Takımyıldız Odak Grafiği" Classes="h2" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Top" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border CornerRadius="999" Width="9" Height="9" Background="{DynamicResource Brush.Amber}" BoxShadow="{DynamicResource Shadow.AmberDot}" VerticalAlignment="Center" />
                                <TextBlock Text="Gerçekleşen" Classes="mono secondary" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Stroke="{DynamicResource Brush.Cyan}" StrokeThickness="1.4" VerticalAlignment="Center" />
                                <TextBlock Text="Planlanan" Classes="mono secondary" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Panel>
                        <rc:ConstellationChart Height="250" Days="{Binding ChartDays}" />
                        <TextBlock Text="Bu hafta için kayıt yok." FontFamily="{DynamicResource Font.Display}" FontStyle="Italic" FontSize="22"
                                   Foreground="{DynamicResource Brush.TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" IsVisible="{Binding !HasData}" />
                    </Panel>
                </StackPanel>
            </Border>

            <!-- Bottom row -->
            <Grid ColumnDefinitions="*,300" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="panel" Padding="26,20,26,16" VerticalAlignment="Top">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Görev ve Proje Dağılımı" Classes="h2" />
                        <TextBlock Text="Haftalık plan ve gerçekleşen karşılaştırması" Classes="faint" FontSize="12" Margin="0,0,0,10" />
                        <TextBlock Text="Bu hafta için görev yok." Classes="faint" FontSize="13" Margin="0,8" IsVisible="{Binding !HasTasks}" />
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReportTaskItemViewModel">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="22,*,200,60,60,66" ColumnSpacing="10">
                                            <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{Binding DotColor}" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="{Binding TaskName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="14" />
                                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                                <rc:CompareBar Planned="{Binding PlannedFraction}" Actual="{Binding ActualFraction}" />
                                                <TextBlock Text="{Binding CaptionText}" Classes="tiny" Classes.mint="{Binding IsCaptionPositive}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding PlannedText}" Classes="mono cyan" HorizontalAlignment="Right" />
                                                <TextBlock Text="PLAN" Classes="tiny" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding ActualText}" Classes="mono amber" HorizontalAlignment="Right" />
                                                <TextBlock Text="GERÇEK" Classes="tiny" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <Border Grid.Column="5" Classes="chip" Classes.pos="{Binding IsPositive}" Classes.neg="{Binding IsNegative}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DifferenceText}" Classes="mono faint" FontSize="12" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="row" Padding="0,12,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding TasksFooterText}" Classes="mono faint" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding FooterPercentText}" Classes="mono amber" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="panel" Padding="24,20" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border CornerRadius="999" Width="6" Height="6" Background="{DynamicResource Brush.Amber}" VerticalAlignment="Center" BoxShadow="{DynamicResource Shadow.AmberDot}" />
                                <TextBlock Text="EN ODAKLI GÜN" Classes="overline" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="chip peak" IsVisible="{Binding HasBestDay}">
                                <TextBlock Text="Zirve" Classes="mono" FontSize="11" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding BestDayName}" Classes="h2" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding BestDayHours}" Classes="numeral-lg amber" FontSize="44" />
                        <TextBlock Text="{Binding BestDayCaption}" Classes="secondary" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
